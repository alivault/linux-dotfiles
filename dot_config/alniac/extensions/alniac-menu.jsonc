{
  // Extend the Quickshell ALNIAC menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        UI icon name shown in the icon column, e.g. "camera", "rust-logo"
  //               (Lucide names; a Nerd Font glyph or an emoji also works).
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `alniac menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"heart","label":"Personal"},
  // "personal.notes": {"icon":"sticky-note","label":"Notes","action":"alniac-launch-editor ~/notes"},
  // "personal.files": {"icon":"folder-open","label":"Files","action":"files ~/Documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"info","label":"About","action":"alniac-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},

  // Preserve clipboard MIME types and surface LocalSend launch errors.
  "trigger.share.clipboard": {"icon":"clipboard","label":"Send Clipboard","aliases":["share-clipboard"],"action":"$HOME/.local/share/alniac/current/shell/plugins/menu/share.sh clipboard"},
  "trigger.capture.screenshot": {"label":"Screenshot selection","description":"Niri native screenshot UI","action":"niri msg action screenshot --show-pointer false"},
  "trigger.capture.screenshot-display": {"icon":"camera","label":"Screenshot display","action":"niri msg action screenshot-screen --show-pointer false"},
  "trigger.capture.screenshot-window": {"icon":"camera","label":"Screenshot focused window","description":"Niri native window capture","action":"niri msg action screenshot-window --show-pointer false"},
  "trigger.capture.text": {"when":"false"},
  // Shared Niri screen recording routes.
  "trigger.capture.screenrecord.stop": {"icon":"video","label":"Stop Screenrecording","action":"alniac-capture-screenrecording --stop-recording","aliases":["screenrecord-stop"]},
  "trigger.capture.screenrecord.fullscreen": {"icon":"video","label":"Full display (no audio)","action":"alniac-capture-screenrecording --fullscreen"},
  "trigger.capture.screenrecord.webcam": {"when":"false"},
}
