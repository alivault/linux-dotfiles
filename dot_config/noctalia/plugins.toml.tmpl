# Plugin code is managed by Noctalia; credentials and runtime data stay local.
[plugins]
enabled = ["noctalia/world_clock", "ali/iweather"]

[[plugins.source]]
name = "official"
kind = "git"
location = "https://github.com/noctalia-dev/official-plugins"
enabled = true

[[plugins.source]]
name = "community"
kind = "git"
location = "https://github.com/noctalia-dev/community-plugins"
enabled = true

[widget.world-clock]
type = "noctalia/world_clock:bar"

[[plugins.source]]
name = "local-dotfiles"
kind = "path"
location = "{{ .chezmoi.homeDir }}/.local/share/noctalia-local-plugins"
enabled = true

[widget.iweather]
type = "ali/iweather:weather"
