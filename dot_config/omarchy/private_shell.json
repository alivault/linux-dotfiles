{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "id": "omarchy.bar",
    "layout": {
      "center": [
        {
          "id": "ali.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "h\n—\nmm\nAP"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "ali.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "io.github.sspaeti.timezones",
          "zones": [
            {
              "label": "Home",
              "shortLabel": "HOME",
              "zone": "",
              "home": true
            },
            {
              "label": "Bergen",
              "shortLabel": "BGO",
              "zone": "Europe/Oslo"
            }
          ],
          "rightClick": "toggleHourFormat",
          "hourFormat": "24h",
          "hoverExpand": false
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "io.github.thisisgm.omapods"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "cloneSourceRestores": [
    "ali.menu"
  ],
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1
}
