{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "id": "omarchy.bar",
    "layout": {
      "center": [
        {
          "id": "ali.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "h\n—\nmm\nAP"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "ali.iweather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "ali.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "ali.world-clock",
          "zones": [
            {
              "label": "New York",
              "zone": "America/New_York"
            },
            {
              "label": "London",
              "zone": "Europe/London"
            },
            {
              "label": "Bergen",
              "zone": "Europe/Oslo"
            },
            {
              "label": "Istanbul",
              "zone": "Europe/Istanbul"
            },
            {
              "label": "Tokyo",
              "zone": "Asia/Tokyo"
            }
          ],
          "hourFormat": "12h"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "cloneSourceRestores": [
    "ali.menu"
  ],
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1
}
