# This repository is intentionally allowlisted. These rules are a second
# line of defense against accidentally adding credentials or runtime state.

# Pi credentials, conversations, caches, and installed packages
home/.pi/agent/auth.json
home/.pi/agent/sessions/
home/.pi/agent/npm/
home/.pi/agent/git/
home/.pi/agent/fff/
home/.pi/agent/models-store.json
home/.pi/agent/trust.json
home/.pi/agent/*changelog*.json

# Credential and secret stores
home/.config/gh/
home/.config/gopass/
home/.config/opencode/
home/.config/pulse/cookie
home/.config/git/credentials

# Browsers and OAuth-bearing launch flags
home/.config/chromium/
home/.config/google-chrome/
home/.config/BraveSoftware/
home/.config/chromium-flags.conf

# ~/.config/oasis is written by Oasis: only seeds, in seed/.config/oasis
home/.config/oasis/

# Historical backups, and home-manager's backups of replaced files
**/*.bak.*
**/*.before-nixos
**/*.before-seed

# Herdr runtime state
home/.config/herdr/logs/
home/.config/herdr/sessions/
home/.local/state/herdr/

# Tmux is deliberately not managed here
home/.config/tmux/
home/.tmux.conf

# Common private-key and environment-file formats
*.pem
*.p12
*.pfx
*.key
.env
.env.*
__pycache__/
