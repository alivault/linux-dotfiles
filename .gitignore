# This repository is intentionally allowlisted. These rules are a second
# line of defense against accidentally adding credentials or runtime state.

# Pi credentials, conversations, caches, and installed packages
private_dot_pi/agent/auth.json
private_dot_pi/agent/sessions/
private_dot_pi/agent/npm/
private_dot_pi/agent/git/
private_dot_pi/agent/fff/
private_dot_pi/agent/models-store.json
private_dot_pi/agent/trust.json
private_dot_pi/agent/*changelog*.json

# Credential and secret stores
dot_config/gh/
dot_config/gopass/
dot_config/opencode/
dot_config/pulse/cookie
dot_config/git/credentials

# Browsers and OAuth-bearing launch flags
dot_config/chromium/
dot_config/google-chrome/
dot_config/BraveSoftware/
dot_config/chromium-flags.conf

# Oasis writes these from the running release; only the user profile is managed
dot_config/oasis/theme.kdl
dot_config/oasis/defaults.kdl
dot_config/oasis/default-bindings.kdl
dot_config/oasis/defaults/
dot_config/oasis/fish/
dot_config/oasis/hooks/
dot_config/oasis/scripts/
dot_config/oasis/themed/
# Your own theme files; the installed/uninstalled choice is tracked.
dot_config/oasis/themes/*
!dot_config/oasis/themes/installed.json
dot_config/oasis/wallpapers/

# Historical backups
**/*.bak.*

# Herdr runtime state
dot_config/herdr/logs/
dot_config/herdr/sessions/
dot_local/state/herdr/

# Tmux is deliberately not managed here
dot_config/tmux/
dot_tmux.conf

# Common private-key and environment-file formats
*.pem
*.p12
*.pfx
*.key
.env
.env.*
__pycache__/
