# Independent ARM64 repack of Debian's static QEMU, with upstream binfmt rules.
# No third-party desktop download URLs, repository or build helpers.
pkgbase=qemu-user-static
pkgname=('qemu-user-static' 'qemu-user-static-binfmt')
pkgver=10.0.11
pkgrel=2
_debver='10.0.11+ds-0+deb13u1+b1'
arch=('aarch64')
url='https://www.qemu.org/'
license=('GPL-2.0-only' 'LGPL-2.1-only')
makedepends=('libarchive')
# Match the original Arch packaging normalization of Debian's static PIE files.
options=('strip' '!debug')
source=(
  'qemu-binfmt-conf.sh::https://raw.githubusercontent.com/qemu/qemu/v10.0.0/scripts/qemu-binfmt-conf.sh'
  "qemu-user_${_debver}_arm64.deb::https://deb.debian.org/debian/pool/main/q/qemu/qemu-user_${_debver}_arm64.deb"
)
sha256sums=(
  '5e12ef484b8364e1ba7bae4acda837d2e6320ffbeb7fab341034124553cdb137'
  '6c9483063bf60f37fe181ead911251deabe40c893ea5829bc34b0b7b88913b6a'
)
noextract=("qemu-user_${_debver}_arm64.deb")

prepare() {
  mkdir -p deb
  bsdtar -C deb -xf "qemu-user_${_debver}_arm64.deb" data.tar.xz
  bsdtar -C deb -xf deb/data.tar.xz ./usr/bin ./usr/share/doc/qemu-user/copyright
}

package_qemu-user-static() {
  pkgdesc='Static QEMU user emulators, independently repackaged from Debian'
  depends=('glibc')
  optdepends=('qemu-user-static-binfmt: foreign-architecture binary registration')
  conflicts=('qemu-user-static-bin')
  local binary
  for binary in deb/usr/bin/qemu-*; do
    install -Dm755 "$binary" "$pkgdir/usr/bin/${binary##*/}-static"
  done
  install -Dm644 deb/usr/share/doc/qemu-user/copyright "$pkgdir/usr/share/licenses/$pkgname/copyright"
}

package_qemu-user-static-binfmt() {
  pkgdesc='Static QEMU binfmt registrations, generated by upstream QEMU'
  depends=('qemu-user-static')
  provides=('qemu-user-binfmt-provider')
  conflicts=('qemu-user-binfmt-provider' 'binfmt-qemu-static')
  install -dm755 "$pkgdir/usr/lib/binfmt.d"
  HOST_ARCH=aarch64 sh "$srcdir/qemu-binfmt-conf.sh" \
    --systemd ALL --exportdir "$pkgdir/usr/lib/binfmt.d" \
    --qemu-path /usr/bin --qemu-suffix -static --persistent yes --preserve-argv0 yes
  local conf
  for conf in "$pkgdir"/usr/lib/binfmt.d/*.conf; do
    mv "$conf" "${conf%.conf}-static.conf"
  done
}
