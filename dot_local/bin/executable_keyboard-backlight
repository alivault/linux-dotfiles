#!/bin/bash
# Percentage steps instead of single hardware levels; retain Noctalia's OSD.
set -euo pipefail
case ${1:-} in
  up) step='10%+' ;;
  down) step='10%-' ;;
  *) echo 'Usage: keyboard-backlight up|down' >&2; exit 2 ;;
esac
result=$(brightnessctl --machine-readable --class=leds --device='*kbd_backlight*' set "$step")
IFS=, read -r device class raw percentage maximum <<< "$result"
percentage=${percentage%\%}
[[ $percentage =~ ^[0-9]+$ ]] || exit 1
noctalia msg keyboard-backlight-osd "$percentage"
