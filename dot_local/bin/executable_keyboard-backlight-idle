#!/bin/bash
# Save the keyboard brightness for idle blanking, then restore it on activity.
set -euo pipefail
state_dir="${XDG_RUNTIME_DIR:?}/keyboard-backlight-idle"
mkdir -p -m 700 "$state_dir"
exec 9>"$state_dir/lock"
flock 9
saved="$state_dir/brightness"
case ${1:-} in
  off)
    if [[ ! -f $saved ]]; then
      brightnessctl --class=leds --device=kbd_backlight get > "$saved"
    fi
    brightnessctl --quiet --class=leds --device=kbd_backlight set 0
    ;;
  restore)
    [[ -f $saved ]] || exit 0
    read -r level < "$saved"
    [[ $level =~ ^[0-9]+$ ]] || exit 1
    brightnessctl --quiet --class=leds --device=kbd_backlight set "$level"
    rm -- "$saved"
    ;;
  *) echo 'Usage: keyboard-backlight-idle off|restore' >&2; exit 2 ;;
esac
