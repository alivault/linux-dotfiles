#!/bin/sh
set -eu

settings=$(cat)
if [ -z "$settings" ]; then
  settings='{}'
fi

printf '%s\n' "$settings" | jq '
  [
    "git:https://github.com/alivault/pi-queue-steer",
    "npm:@ogulcancelik/pi-herdr",
    "npm:@ff-labs/pi-fff",
    "npm:pi-mcp-adapter",
    "npm:@howaboua/pi-codex-conversion"
  ] as $required_packages
  | (if (.packages | type) == "array" then .packages else [] end) as $existing_packages
  | .quietStartup = true
  | .treeFilterMode = "no-tools"
  | .defaultProvider = "openai-codex"
  | .defaultModel = "gpt-5.6-sol"
  | .defaultThinkingLevel = "high"
  | .hideThinkingBlock = true
  | .packages = (
      $required_packages
      + [
          $existing_packages[]
          | . as $package
          | select(
              $package != "git:git@github.com:alivault/pi-queue-steer"
              and ($required_packages | index($package)) == null
            )
        ]
    )
'
