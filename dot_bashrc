# Keep pi-fff from indexing the entire home directory by default.
# An explicit environment value or Pi CLI flag can still override this.
pi() {
  FFF_ENABLE_HOME_SCAN="${FFF_ENABLE_HOME_SCAN:-0}" command pi "$@"
}

