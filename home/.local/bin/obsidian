#!/bin/sh

set -eu

# NixOS: no /usr/bin/obsidian (envfs maps /usr/bin to PATH, so testing it
# found this script and it ran itself in a loop). The Flatpak is the app.
if [ -x "$HOME/.local/opt/obsidian/Obsidian.AppImage" ]; then
  exec "$HOME/.local/opt/obsidian/Obsidian.AppImage" --no-sandbox "$@"
fi

if command -v flatpak >/dev/null 2>&1 &&
  flatpak info md.obsidian.Obsidian >/dev/null 2>&1; then
  exec flatpak run md.obsidian.Obsidian "$@"
fi

echo "Obsidian is not installed." >&2
exit 1
